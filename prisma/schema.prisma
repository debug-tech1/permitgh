// ServeTrack data model — see FIG. 3 (Entity-Relationship Diagram) in the
// published system design doc for the illustrative version of this schema.
// Deliberately avoids Prisma enums so the same schema worked unchanged on
// SQLite during local dev and now on PostgreSQL in production — the only
// change needed was this provider line and the driver adapter in db.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String   @id @default(uuid())
  name                  String
  email                 String   @unique
  passwordHash          String
  role                  String // "citizen" | "officer" | "admin"
  assignedServiceTypeId String?
  createdAt             DateTime @default(now())

  assignedServiceType ServiceType?     @relation(fields: [assignedServiceTypeId], references: [id])
  requestsSubmitted   ServiceRequest[] @relation("CitizenRequests")
  statusChangesMade   StatusHistory[]  @relation("OfficerStatusChanges")

  @@index([role])
}

model ServiceType {
  id                String   @id @default(uuid())
  name              String   @unique
  slug              String   @unique
  slaDays           Int
  description       String
  requiredDocuments String[] @default([])
  feeGhs            Int      @default(0) // whole Ghana Cedis — display only, no payment processing
  feeTiers          Json? // optional [{label, feeGhs}, ...] — when set, fee depends on a size the applicant picks (e.g. storeys); feeGhs above is the "from" price
  createdAt         DateTime @default(now())

  requests ServiceRequest[]
  officers User[]
}

model ServiceRequest {
  id            String    @id @default(uuid())
  citizenId     String
  serviceTypeId String
  status        String // "received" | "under_review" | "additional_info_needed" | "approved" | "rejected"
  applicantNote String
  submittedAt   DateTime  @default(now())
  slaDeadline   DateTime
  resolvedAt    DateTime?
  feeGhs        Int? // flat-fee services: set at submission. Officer-billed services (tiered or formula): null until billed. Never changes once set, same "never drifts" rule as slaDeadline
  sizeTier      String? // label of the assessed tier/category (e.g. "2 storeys", "Retail / Trading"), for tier-billed services
  billingDetail String? // human-readable breakdown of how feeGhs was computed — the audit trail a flat number alone can't carry
  waiverGhs     Int      @default(0) // amount waived by the billing officer, subtracted from the gross fee
  waiverReason  String? // required (enforced in the action, not the schema) whenever waiverGhs > 0
  paidAt        DateTime? // set when the billing officer confirms payment happened outside ServeTrack — approval is blocked until this is set

  citizen     User            @relation("CitizenRequests", fields: [citizenId], references: [id])
  serviceType ServiceType     @relation(fields: [serviceTypeId], references: [id])
  history     StatusHistory[]
  attachments Attachment[]

  @@index([serviceTypeId, status])
  @@index([citizenId])
}

model StatusHistory {
  id        String   @id @default(uuid())
  requestId String
  status    String
  remark    String?
  changedById String
  changedAt DateTime @default(now())

  request   ServiceRequest @relation(fields: [requestId], references: [id])
  changedBy User           @relation("OfficerStatusChanges", fields: [changedById], references: [id])

  @@index([requestId])
}

model Attachment {
  id         String   @id @default(uuid())
  requestId  String
  fileName   String
  fileUrl    String // data URI — demo-scale only, see technical debt log
  uploadedAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}
